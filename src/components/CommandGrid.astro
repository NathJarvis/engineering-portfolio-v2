---
---

<div id="viewport-container">
  <canvas id="viewport-canvas"></canvas>

  <!-- Floating Dynamic 3D Tooltip -->
  <div id="node-tooltip" class="node-tooltip">
    <div class="tooltip-tag" id="tooltip-tag">STATION // 01</div>
    <div class="tooltip-label" id="tooltip-label">RESEARCH & PREPRINTS</div>
    <div class="tooltip-dest" id="tooltip-dest">DEST: /research ↗</div>
  </div>

  <!-- HUD: Top Left Identity -->
  <div class="hud top-left">
    <div class="hud-title">NATHAN JARVIS</div>
    <div class="hud-subtitle">SYSTEMS &bull; EMPIRICAL RESEARCH &bull; HARDWARE</div>
  </div>

  <!-- HUD: Top Right Telemetry -->
  <div class="hud top-right">
    <div class="hud-panel fps-box">
      <span class="pulse-dot"></span>
      <span id="fps-counter">60</span> FPS
    </div>
  </div>

  <!-- HUD: Bottom Left Controls -->
  <div class="hud bottom-left">
    <label class="toggle-control">
      <input type="checkbox" id="toggle-grid" checked />
      <span>GRID LINES</span>
    </label>
  </div>

  <!-- HUD: Bottom Center Navigation Hint -->
  <div class="hud bottom-center">
    <div class="hud-panel nav-hint" id="hud-nav-status">
      LEFT-CLICK + DRAG TO ORBIT &bull; HOVER NODE TO INSPECT
    </div>
  </div>

  <!-- HUD: Bottom Right Links -->
  <div class="hud bottom-right">
    <div class="status-badge">
      <span class="status-indicator"></span> OPEN TO COLLABORATION
    </div>
    <div class="hud-links">
      <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LINKEDIN ↗</a>
      <a href="https://github.com" target="_blank" rel="noopener noreferrer">GITHUB ↗</a>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  const container = document.getElementById('viewport-container');
  const canvas = document.getElementById('viewport-canvas') as HTMLCanvasElement;
  const fpsDisplay = document.getElementById('fps-counter');
  const toggleGrid = document.getElementById('toggle-grid') as HTMLInputElement;
  const navStatus = document.getElementById('hud-nav-status');

  // Tooltip DOM Elements
  const tooltip = document.getElementById('node-tooltip');
  const tooltipTag = document.getElementById('tooltip-tag');
  const tooltipLabel = document.getElementById('tooltip-label');
  const tooltipDest = document.getElementById('tooltip-dest');

  if (container && canvas) {
    // 1. Scene & Isometric Camera Setup
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x030712);
    scene.fog = new THREE.FogExp2(0x030712, 0.025);

    const aspect = window.innerWidth / window.innerHeight;
    const d = 16;
    const camera = new THREE.OrthographicCamera(
      -d * aspect, d * aspect, d, -d, -100, 1000
    );

    camera.position.set(20, 20, 20);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // 2. Smooth OrbitControls
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.enablePan = false;
    controls.maxPolarAngle = Math.PI / 2.1; // Don't allow camera under floor
    controls.minZoom = 0.6;
    controls.maxZoom = 2.0;

    // 3. Lighting
    const ambientLight = new THREE.AmbientLight(0xdbeafe, 0.8);
    scene.add(ambientLight);

    const keyLight = new THREE.DirectionalLight(0x38bdf8, 1.5);
    keyLight.position.set(15, 25, 10);
    scene.add(keyLight);

    const rimLight = new THREE.DirectionalLight(0x818cf8, 1.0);
    rimLight.position.set(-15, 10, -15);
    scene.add(rimLight);

    // 4. Grid Floor & Circuit Lines
    const grid = new THREE.GridHelper(50, 50, 0x38bdf8, 0x111c38);
    grid.position.y = 0;
    scene.add(grid);

    if (toggleGrid) {
      toggleGrid.addEventListener('change', () => {
        grid.visible = toggleGrid.checked;
      });
    }

    const traceMat = new THREE.LineBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.7 });
    const createTrace = (coords: [number, number, number][]) => {
      const pts = coords.map(c => new THREE.Vector3(...c));
      const geom = new THREE.BufferGeometry().setFromPoints(pts);
      return new THREE.Line(geom, traceMat);
    };

    scene.add(createTrace([[0, 0.01, 0], [7, 0.01, 0], [7, 0.01, 7]]));
    scene.add(createTrace([[0, 0.01, 0], [-7, 0.01, 0], [-7, 0.01, -7]]));
    scene.add(createTrace([[0, 0.01, 0], [0, 0.01, -7], [7, 0.01, -7]]));
    scene.add(createTrace([[0, 0.01, 0], [0, 0.01, 7], [-7, 0.01, 7]]));

    // 5. Interactive Stations
    const interactiveMeshes: THREE.Mesh[] = [];

    const createStationBase = (x: number, z: number, r = 2.2) => {
      const ringGeom = new THREE.CylinderGeometry(r, r + 0.2, 0.15, 32);
      const ringMat = new THREE.MeshStandardMaterial({
        color: 0x090f21,
        roughness: 0.4,
        metalness: 0.8
      });
      const mesh = new THREE.Mesh(ringGeom, ringMat);
      mesh.position.set(x, 0.08, z);
      scene.add(mesh);
    };

    // Central Core Hub -> /
    createStationBase(0, 0, 2.5);
    const coreGeom = new THREE.BoxGeometry(2, 0.6, 2);
    const coreMat = new THREE.MeshStandardMaterial({
      color: 0x38bdf8,
      emissive: 0x0284c7,
      emissiveIntensity: 0.6,
      roughness: 0.2,
      metalness: 0.9
    });
    const coreMesh = new THREE.Mesh(coreGeom, coreMat);
    coreMesh.position.set(0, 0.4, 0);
    coreMesh.userData = {
      targetUrl: '/',
      label: 'SYSTEM CORE',
      tag: 'SYSTEM // 00',
      dest: '/'
    };
    scene.add(coreMesh);
    interactiveMeshes.push(coreMesh);

    // STATION 01: RESEARCH & PREPRINTS (7, 7) -> /research
    createStationBase(7, 7, 2.2);
    const serverGroup = new THREE.Group();
    serverGroup.position.set(7, 0, 7);
    for (let i = -1; i <= 1; i++) {
      const rack = new THREE.Mesh(
        new THREE.BoxGeometry(0.7, 2.6, 1.2),
        new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.5, metalness: 0.7 })
      );
      rack.position.set(i * 0.9, 1.3, 0);
      serverGroup.add(rack);
    }
    const researchHit = new THREE.Mesh(
      new THREE.BoxGeometry(3, 3, 2),
      new THREE.MeshBasicMaterial({ visible: false })
    );
    researchHit.position.set(7, 1.5, 7);
    researchHit.userData = {
      targetUrl: '/research',
      label: 'RESEARCH & PREPRINTS',
      tag: 'STATION // 01',
      dest: '/research'
    };
    scene.add(serverGroup, researchHit);
    interactiveMeshes.push(researchHit);

    // STATION 02: TECHNICAL BLOG & DEEP DIVES (-7, -7) -> /blog
    createStationBase(-7, -7, 2.2);
    const blogMesh = new THREE.Mesh(
      new THREE.CylinderGeometry(0.8, 1.2, 1.8, 6),
      new THREE.MeshStandardMaterial({
        color: 0x818cf8,
        emissive: 0x4338ca,
        emissiveIntensity: 0.5,
        metalness: 0.6
      })
    );
    blogMesh.position.set(-7, 1.0, -7);
    blogMesh.userData = {
      targetUrl: '/blog',
      label: 'TECHNICAL BLOG & NOTES',
      tag: 'STATION // 02',
      dest: '/blog'
    };
    scene.add(blogMesh);
    interactiveMeshes.push(blogMesh);

    // STATION 03: EXPERIENCE & BIO (7, -7) -> /about
    createStationBase(7, -7, 2.2);
    const expMesh = new THREE.Mesh(
      new THREE.BoxGeometry(1.6, 1.4, 1.2),
      new THREE.MeshStandardMaterial({
        color: 0x34d399,
        emissive: 0x059669,
        emissiveIntensity: 0.4,
        metalness: 0.8
      })
    );
    expMesh.position.set(7, 0.8, -7);
    expMesh.userData = {
      targetUrl: '/about',
      label: 'EXPERIENCE & CREDENTIALS',
      tag: 'STATION // 03',
      dest: '/about'
    };
    scene.add(expMesh);
    interactiveMeshes.push(expMesh);

    // STATION 04: CONTACT & INQUIRIES (-7, 7) -> /contact
    createStationBase(-7, 7, 2.2);
    const contactDish = new THREE.Mesh(
      new THREE.SphereGeometry(0.9, 16, 16, 0, Math.PI * 2, 0, Math.PI * 0.5),
      new THREE.MeshStandardMaterial({
        color: 0xf59e0b,
        emissive: 0xb45309,
        emissiveIntensity: 0.5,
        metalness: 0.8,
        side: THREE.DoubleSide
      })
    );
    contactDish.position.set(-7, 1.2, 7);
    contactDish.rotation.x = Math.PI * 0.25;
    contactDish.userData = {
      targetUrl: '/contact',
      label: 'CONTACT & INQUIRIES',
      tag: 'STATION // 04',
      dest: '/contact'
    };
    scene.add(contactDish);
    interactiveMeshes.push(contactDish);

    // 6. Raycast, Hover & Click Handlers
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();
    let clientMouseX = 0;
    let clientMouseY = 0;
    let downPos = { x: 0, y: 0 };
    let currentHovered: THREE.Mesh | null = null;

    window.addEventListener('mousedown', (e) => {
      downPos = { x: e.clientX, y: e.clientY };
    });

    window.addEventListener('mousemove', (e) => {
      clientMouseX = e.clientX;
      clientMouseY = e.clientY;
      mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
      mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
    });

    window.addEventListener('mouseup', (e) => {
      const movedX = Math.abs(e.clientX - downPos.x);
      const movedY = Math.abs(e.clientY - downPos.y);

      // Only navigate if it was a distinct click, not a camera drag
      if (movedX < 5 && movedY < 5) {
        raycaster.setFromCamera(mouse, camera);
        const hits = raycaster.intersectObjects(interactiveMeshes);
        if (hits.length > 0) {
          const target = hits[0].object;
          if (target.userData?.targetUrl) {
            window.location.href = target.userData.targetUrl;
          }
        }
      }
    });

    // 7. Window Resize Handler
    window.addEventListener('resize', () => {
      const asp = window.innerWidth / window.innerHeight;
      camera.left = -d * asp;
      camera.right = d * asp;
      camera.top = d;
      camera.bottom = -d;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // 8. Animation & Telemetry Loop
    let lastTime = performance.now();
    let frameCount = 0;

    const animate = () => {
      requestAnimationFrame(animate);

      controls.update();

      frameCount++;
      const now = performance.now();
      if (now - lastTime >= 1000) {
        if (fpsDisplay) fpsDisplay.innerText = frameCount.toString();
        frameCount = 0;
        lastTime = now;
      }

      // Hover Raycasting
      raycaster.setFromCamera(mouse, camera);
      const hits = raycaster.intersectObjects(interactiveMeshes);

      if (hits.length > 0) {
        const hit = hits[0].object as THREE.Mesh;
        currentHovered = hit;
        document.body.style.cursor = 'pointer';

        if (tooltip && tooltipTag && tooltipLabel && tooltipDest && navStatus) {
          tooltipTag.innerText = hit.userData.tag || 'STATION';
          tooltipLabel.innerText = hit.userData.label || 'NODE';
          tooltipDest.innerText = `ENTER -> ${hit.userData.dest}`;
          
          tooltip.style.opacity = '1';
          tooltip.style.transform = `translate(${clientMouseX + 16}px, ${clientMouseY - 20}px)`;

          navStatus.innerHTML = `DESTINATION LOCKED: <span style="color: var(--neon-cyan); font-weight: 600;">${hit.userData.dest}</span> &bull; CLICK TO INITIALIZE`;
        }
      } else {
        if (currentHovered) {
          currentHovered = null;
          document.body.style.cursor = 'default';
          if (tooltip && navStatus) {
            tooltip.style.opacity = '0';
            navStatus.innerHTML = `LEFT-CLICK + DRAG TO ORBIT &bull; HOVER NODE TO INSPECT`;
          }
        }
      }

      renderer.render(scene, camera);
    };

    animate();
  }
</script>

<style>
  #viewport-container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden; /* Keeps the 3D home screen neatly locked within the viewport */
  }
  #viewport-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Floating 3D Hover Tooltip */
  .node-tooltip {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 100;
    opacity: 0;
    transition: opacity 0.15s ease-out;
    background: rgba(7, 12, 24, 0.92);
    border: 1px solid var(--neon-cyan);
    padding: 0.6rem 0.9rem;
    border-radius: 6px;
    backdrop-filter: blur(10px);
    box-shadow: 0 0 15px rgba(56, 189, 248, 0.25);
    font-family: var(--font-mono);
  }
  .tooltip-tag {
    font-size: 0.65rem;
    color: var(--neon-emerald);
    letter-spacing: 0.08em;
    margin-bottom: 0.2rem;
  }
  .tooltip-label {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: #f8fafc;
    letter-spacing: 0.04em;
  }
  .tooltip-dest {
    font-size: 0.75rem;
    color: var(--neon-cyan);
    margin-top: 0.25rem;
  }

  /* HUD Layout Elements */
  .hud {
    position: absolute;
    z-index: 10;
    font-family: var(--font-mono);
  }
  .top-left {
    top: 2rem;
    left: 2.5rem;
  }
  .hud-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #f8fafc;
  }
  .hud-subtitle {
    font-size: 0.75rem;
    color: var(--neon-cyan);
    letter-spacing: 0.12em;
    margin-top: 0.2rem;
  }

  .top-right {
    top: 2rem;
    right: 2.5rem;
  }
  .hud-panel {
    background: var(--hud-bg);
    border: 1px solid var(--hud-border);
    padding: 0.5rem 0.9rem;
    border-radius: 4px;
    backdrop-filter: blur(8px);
    font-size: 0.8rem;
    color: #94a3b8;
  }
  .fps-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--neon-emerald);
    box-shadow: 0 0 8px var(--neon-emerald);
  }

  .bottom-left {
    bottom: 2rem;
    left: 2.5rem;
  }
  .toggle-control {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #94a3b8;
    cursor: pointer;
  }
  .toggle-control input {
    accent-color: var(--neon-cyan);
    cursor: pointer;
  }

  .bottom-center {
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
  }
  .nav-hint {
    letter-spacing: 0.06em;
    font-size: 0.75rem;
    color: #cbd5e1;
  }

  .bottom-right {
    bottom: 2rem;
    right: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.6rem;
  }
  .status-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    background: rgba(52, 211, 153, 0.1);
    border: 1px solid rgba(52, 211, 153, 0.3);
    color: var(--neon-emerald);
    padding: 0.3rem 0.7rem;
    border-radius: 4px;
  }
  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--neon-emerald);
    box-shadow: 0 0 6px var(--neon-emerald);
  }
  .hud-links {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--neon-cyan);
  }
  .hud-links a:hover {
    color: #f8fafc;
  }
</style>